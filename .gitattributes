# Everyone on this project works on Windows, so normalize all text files
# to CRLF on checkout (and on checkin) instead of using core.autocrlf, which
# depends on per-machine git config and is a common source of diff noise.
* text=auto eol=crlf

# Source / project files
*.cs      text eol=crlf diff=csharp
*.xaml    text eol=crlf
*.csproj  text eol=crlf
*.sln     text eol=crlf
*.props   text eol=crlf
*.targets text eol=crlf
*.editorconfig text eol=crlf

# Config / data
*.json    text eol=crlf
*.xml     text eol=crlf
*.txt     text eol=crlf

# Scripts
*.ps1     text eol=crlf
*.py      text eol=crlf

# Docs
*.md      text eol=crlf

# Binary — never touch line endings or attempt text diffs
*.dll     binary
*.exe     binary
*.pdb     binary
*.ico     binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.zip     binary
