<Project Sdk="Microsoft.NET.Sdk">

  <!-- CENTRAL-BANK DECISION SCENARIO HARNESS (2026-08-27).
       A console runner, NOT an xunit project, and deliberately OUT of RatesWeekly.sln:
       every scenario needs its OWN config\meetings.json, and MeetingsStore loads that file
       once per PROCESS through a static Lazy. One process per scenario is the only way to
       exercise the real loader, the real BuildWeekly and the real renderers against a
       synthetic decision calendar - so the harness runs the SHIPPING code paths, with only
       the market data faked. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>RateDesk.Scenarios</AssemblyName>
    <RootNamespace>RateDesk.Scenarios</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RateDesk.Core\RateDesk.Core.csproj" />
    <ProjectReference Include="..\..\src\RateDesk.Weekly.Core\RateDesk.Weekly.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- the REAL run definitions: every scenario starts from the shipped ticker roots,
         sources, fixing tickers and guard futures, and overrides only the calendar. -->
    <None Include="..\..\config\meetings.json" Link="meetings.template.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
