<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="QLNet" Version="1.13.1" />
  </ItemGroup>

  <!-- currency configs baked into the assembly: the published exe needs no external files -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\config\currencies\*.json"
                      LogicalName="RateDesk.Core.config.currencies.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\config\meetings.json"
                      LogicalName="RateDesk.Core.config.meetings.json" />
    <EmbeddedResource Include="..\..\config\correlations.json"
                      LogicalName="RateDesk.Core.config.correlations.json" />
  </ItemGroup>

</Project>
