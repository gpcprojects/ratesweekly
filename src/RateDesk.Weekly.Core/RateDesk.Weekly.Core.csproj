<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RateDesk.Core\RateDesk.Core.csproj" />
    <ProjectReference Include="..\RateDesk.Bloomberg\RateDesk.Bloomberg.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- macro-enabled save-down templates (clean-room replicas of the desk's incumbent
         store workbooks' VBA, built 2026-08-25 via tools; regenerate with the template
         builder script if the store machinery ever changes) — embedded so the exe stays
         standalone -->
    <EmbeddedResource Include="..\..\templates\OIS_Store_Template.xlsm" />
    <EmbeddedResource Include="..\..\templates\Inflation_Store_Template.xlsm" />
    <!-- THE DESK'S HISTORY SHIPS INSIDE THE APP (desk 2026-09-02: "the app is STANDALONE -
         incorporate the history INTO the app, that way it can't be missed"). Refreshed from the
         live store at every release (VACUUM INTO assets\history_seed.db) - the release ritual's
         own step, and the manifest txt is shown at startup so a stale seed is visible. -->
    <EmbeddedResource Include="..\..\assets\history_seed.db" />
    <EmbeddedResource Include="..\..\assets\history_seed.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- embedded engine, single native e_sqlite3 — bundles into a single-file publish -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <!-- the daily OIS workbook (runs + history sheets). MIT; bundles into the single-file
         publish like everything else — no runtime file dependencies. -->
    <PackageReference Include="ClosedXML" Version="0.104.2" />
  </ItemGroup>

</Project>
