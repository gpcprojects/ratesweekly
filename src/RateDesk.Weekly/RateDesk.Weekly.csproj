<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>RatesWeekly</AssemblyName>
    <Product>RatesWeekly</Product>
    <AssemblyTitle>RatesWeekly — Weekly Rates Dashboards &amp; Desk Email</AssemblyTitle>
    <Description>One-click weekly: Bloomberg pull, maintained history, dashboard publish, desk email</Description>
    <Company>Gabriel Pycroft</Company>
    <Copyright>© 2026 Gabriel Pycroft</Copyright>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>0.10.8</Version>
    <FileVersion>0.10.8.0</FileVersion>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <!-- truly standalone single file, same rationale as Dodgeball: WPF + sqlite natives must bundle -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RateDesk.Weekly.Core\RateDesk.Weekly.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- the JBDH banner for the daily email header — embedded so the exe stays standalone -->
    <EmbeddedResource Include="..\..\assets\jbdh_banner.jpg" />
  </ItemGroup>

  <!-- configs are embedded in RateDesk.Core; user/market state lives in %APPDATA%\RatesWeekly only -->

</Project>
