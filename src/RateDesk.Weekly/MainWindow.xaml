<Window x:Class="RateDesk.Weekly.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RatesWeekly" Width="760" Height="520"
        Background="#14171c" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- a disabled button must LOOK disabled on the dark theme, or the gate reads as a bug -->
        <Style TargetType="Button">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="RatesWeekly" FontSize="20" FontWeight="Bold" Foreground="#e8ecf2"/>
            <TextBlock x:Name="VersionText" FontSize="12" Foreground="#66707f"
                       VerticalAlignment="Bottom" Margin="10,0,0,2"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="UpdateBtn" Content="WEEKLY RUN" Click="Update_Click"
                    Width="120" Height="34" FontWeight="Bold"
                    Background="#1f6feb" Foreground="White" BorderThickness="0"/>
            <!-- STALE-OUTPUT SAFEGUARD (desk 2026-08-20): only UPDATE is live on open — the
                 other buttons serve whatever a PREVIOUS session left in out\, and sending
                 yesterday's email because a button happened to be clickable is exactly the
                 fault class this app exists to remove. They unlock when THIS session's
                 update has rebuilt what they serve. -->
            <Button x:Name="CreateEmailBtn" Content="CREATE EMAIL" Click="CreateEmail_Click"
                    Width="120" Height="34" Margin="8,0,0,0" IsEnabled="False"
                    Background="#2a3038" Foreground="#e8ecf2" BorderThickness="0"/>
            <Button x:Name="CopyEmailBtn" Content="COPY EMAIL" Click="CopyEmail_Click"
                    Width="120" Height="34" Margin="8,0,0,0" IsEnabled="False"
                    Background="#2a3038" Foreground="#e8ecf2" BorderThickness="0"/>
            <Button x:Name="OpenOutBtn" Content="OPEN OUTPUT" Click="OpenOutput_Click"
                    Width="120" Height="34" Margin="8,0,0,0" IsEnabled="False"
                    Background="#2a3038" Foreground="#e8ecf2" BorderThickness="0"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <!-- the DAILY surface (desk 2026-08-20): DAILY RUN builds fresh so it is live on
                 open; COPY BLAST and CREATE DAILY EMAIL serve what a run wrote, so they unlock
                 only once THIS session has built one — same stale-output gate as the weekly. -->
            <Button x:Name="DailyBtn" Content="DAILY RUN" Click="Daily_Click"
                    Width="120" Height="34" FontWeight="Bold"
                    Background="#238636" Foreground="White" BorderThickness="0"/>
            <Button x:Name="CopyBlastBtn" Content="COPY BLAST" Click="CopyBlast_Click"
                    Width="120" Height="34" Margin="8,0,0,0" IsEnabled="False"
                    Background="#2a3038" Foreground="#e8ecf2" BorderThickness="0"/>
            <Button x:Name="DailyEmailBtn" Content="DAILY EMAIL" Click="DailyEmail_Click"
                    Width="120" Height="34" Margin="8,0,0,0" IsEnabled="False"
                    Background="#2a3038" Foreground="#e8ecf2" BorderThickness="0"/>
        </StackPanel>

        <TextBox Grid.Row="3" x:Name="LogBox" IsReadOnly="True"
                 Background="#0d1015" Foreground="#c9cfd8" BorderThickness="0"
                 FontFamily="Consolas" FontSize="12" Padding="8"
                 VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>

        <TextBlock Grid.Row="4" x:Name="StatusText" Margin="0,8,0,0"
                   Foreground="#66707f" FontSize="12"
                   Text="Bloomberg terminal must be running and logged in (localhost:8194)."/>
    </Grid>
</Window>
